# Whispr — copy to .env.local and fill in. Never commit real values.

# Django
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database — Neon Postgres
# Format: postgres://<user>:<pw>@<host>/<db>?sslmode=require
DATABASE_URL=

# Upstash Redis
# Format: rediss://default:<token>@<endpoint>:<port>
REDIS_URL=

# Ably (realtime) — sign up at ably.com, create app "whispr-dev", copy the Root key
ABLY_API_KEY=

# Groq (LLM) — sign up at groq.com, create API key
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback/google

# Gmail SMTP for outbound mail (magic links, etc.)
# Use a Gmail App Password (myaccount.google.com → Security → 2FA → App passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Whispr <your-gmail-address@gmail.com>

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_ABLY_AUTH_URL=http://localhost:8000/api/ably-token
